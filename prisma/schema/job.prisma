model Job {
  id                 String          @id @default(uuid())
  title              String
  description        String[]
  Who_can_apply      String
  benefits           String?
  location           String
  startDate          DateTime
  skills             String[]
  numberOfVacancies  Int
  Duration           String
  jobType            JobType         @default(ONSITE)
  contract           JobContractType @default(FULLTIME)
  status             JobStatus       @default(PENDING_PAYMENT)
  createdAt          DateTime        @default(now())
  expiresAt          DateTime?

  categoryId         String
  category           Category        @relation(fields: [categoryId], references: [id])

  experienceLevel    ExperienceLevel
  maxSalary          String
  minSalary          String
  other_requirements String[]
  isDeleted          Boolean?          @default(false)

  recruiterId        String
  recruiter          Recruiter       @relation(fields: [recruiterId], references: [id])

  applications       Application[]
  payment            Payment?
  bookmarkedBy User[] @relation("BookmarkedJobs")
}

model Category {
  id   String @id @default(uuid())
  name String
  jobs Job[]
}

enum JobStatus {
  PENDING_PAYMENT
  HOLD
  ACTIVE
  EXPIRED
}

enum JobContractType {
  FULLTIME
  PARTTIME
  INTERNSHIP
}

enum JobType {
  REMOTE
  ONSITE
}

enum ExperienceLevel {
  Entry
  Mid
  Senior
  Lead
}
