generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  password       String
  role           Role          @default(USER)
  status         UserStatus?   @default(ACTIVE)
  isVerified     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  applications   Application[]
  bookmarkJobs   Job[]         @relation("BookmarkedJobs")
  recruiter      Recruiter?
  userInfo       UserInfo?
  interviewPreparations InterviewPreparation[]
}

model Recruiter {
  id           String    @id @default(uuid())
  userId       String    @unique
  about        String?
  website      String?
  location     String?
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  companyImage String?
  companyName  String?
  jobs         Job[]
  payments     Payment[]
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserInfo {
  id        String   @id @default(uuid())
  userId    String   @unique
  about     String?
  image     String?
  website   String?
  location  String?
  phone     String?
  linkedin  String?
  github    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  RECRUITER
  ADMIN
}


enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}